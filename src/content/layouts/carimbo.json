{
  "id": "carimbo",
  "name": "Carimbo",
  "version": 1,
  "canvas": {
    "width": 1080,
    "height": 1080
  },
  "background": "#000000",
  "premium": false,
  "slots": [
    {
      "id": "top",
      "label": "Texto de cima",
      "type": "top",
      "maxChars": 40,
      "maxLines": 2,
      "multiline": false,
      "placeholder": "EU PEDINDO PRA SAIR MAIS CEDO",
      "optional": true
    },
    {
      "id": "stamp",
      "label": "Carimbo",
      "type": "label",
      "maxChars": 14,
      "maxLines": 1,
      "multiline": false,
      "placeholder": "NEGADO"
    },
    {
      "id": "reason",
      "label": "Motivo",
      "type": "caption",
      "maxChars": 80,
      "maxLines": 3,
      "multiline": true,
      "placeholder": "por já ter usado essa desculpa em março",
      "optional": true
    }
  ],
  "elements": [
    {
      "id": "photo",
      "type": "image",
      "x": 0,
      "y": 0,
      "width": 1080,
      "height": 1080,
      "defaultFit": "cover"
    },
    {
      "id": "top-text",
      "type": "text",
      "content": "{{top}}",
      "fontRole": "display",
      "font": "anton",
      "fontSize": 76,
      "minFontSize": 44,
      "color": "#FFFFFF",
      "align": "center",
      "valign": "top",
      "uppercase": true,
      "outline": {
        "color": "#000000",
        "width": 6
      },
      "shadow": true,
      "hideWhenEmpty": true,
      "draggable": true,
      "x": 40,
      "y": 50,
      "width": 1000,
      "height": 200
    },
    {
      "id": "stamp-box",
      "type": "rect",
      "x": 140,
      "y": 400,
      "width": 800,
      "height": 250,
      "fill": "transparent",
      "radius": 16,
      "border": {
        "color": "#E5383B",
        "width": 12
      },
      "rotation": -12,
      "opacity": 0.92
    },
    {
      "id": "stamp-text",
      "type": "text",
      "content": "{{stamp}}",
      "fontRole": "display",
      "font": "anton",
      "fontSize": 130,
      "minFontSize": 64,
      "color": "#E5383B",
      "align": "center",
      "valign": "middle",
      "uppercase": true,
      "letterSpacing": 6,
      "rotation": -12,
      "opacity": 0.92,
      "x": 140,
      "y": 400,
      "width": 800,
      "height": 250
    },
    {
      "id": "reason-text",
      "type": "text",
      "content": "{{reason}}",
      "fontRole": "display",
      "font": "oswald",
      "fontSize": 54,
      "minFontSize": 34,
      "color": "#FFFFFF",
      "align": "center",
      "valign": "bottom",
      "uppercase": true,
      "outline": {
        "color": "#000000",
        "width": 5
      },
      "shadow": true,
      "hideWhenEmpty": true,
      "draggable": true,
      "x": 60,
      "y": 790,
      "width": 960,
      "height": 190
    },
    {
      "id": "brand",
      "type": "brand",
      "variant": "pill",
      "x": 560,
      "y": 1000,
      "width": 480,
      "height": 56
    }
  ]
}
