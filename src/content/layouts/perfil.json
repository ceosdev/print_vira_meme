{
  "id": "perfil",
  "name": "Perfil",
  "version": 1,
  "canvas": {
    "width": 1080,
    "height": 1350,
    "heightWithoutBrand": 1286
  },
  "background": "#0F0F14",
  "premium": false,
  "slots": [
    {
      "id": "name",
      "label": "Nome",
      "type": "name",
      "maxChars": 24,
      "maxLines": 1,
      "multiline": false,
      "placeholder": "Eu, todo dia útil"
    },
    {
      "id": "handle",
      "label": "Arroba",
      "type": "label",
      "maxChars": 20,
      "maxLines": 1,
      "multiline": false,
      "placeholder": "cansado.oficial"
    },
    {
      "id": "bio",
      "label": "Bio",
      "type": "description",
      "maxChars": 90,
      "maxLines": 3,
      "multiline": true,
      "placeholder": "Vivo de café e de promessas que faço pra mim mesmo na segunda"
    },
    {
      "id": "stat-1",
      "label": "Número 1",
      "type": "stat",
      "maxChars": 24,
      "maxLines": 2,
      "multiline": true,
      "placeholder": "0\nDisposição"
    },
    {
      "id": "stat-2",
      "label": "Número 2",
      "type": "stat",
      "maxChars": 24,
      "maxLines": 2,
      "multiline": true,
      "placeholder": "847\nAbas abertas",
      "optional": true
    },
    {
      "id": "stat-3",
      "label": "Número 3",
      "type": "stat",
      "maxChars": 24,
      "maxLines": 2,
      "multiline": true,
      "placeholder": "1\nAmigo que responde",
      "optional": true
    },
    {
      "id": "caption",
      "label": "Legenda",
      "type": "caption",
      "maxChars": 70,
      "maxLines": 2,
      "multiline": true,
      "placeholder": "Perfil atualizado pela última vez em 2019",
      "optional": true
    }
  ],
  "elements": [
    {
      "id": "cover",
      "type": "rect",
      "x": 0,
      "y": 0,
      "width": 1080,
      "height": 300,
      "fill": "#1C1C26"
    },
    {
      "id": "photo-ring",
      "type": "rect",
      "x": 378,
      "y": 178,
      "width": 324,
      "height": 324,
      "fill": "#FFD60A",
      "radius": 162
    },
    {
      "id": "photo",
      "type": "image",
      "x": 390,
      "y": 190,
      "width": 300,
      "height": 300,
      "radius": 150,
      "defaultFit": "cover"
    },
    {
      "id": "name-text",
      "type": "text",
      "content": "{{name}}",
      "fontRole": "display",
      "font": "oswald",
      "fontSize": 68,
      "minFontSize": 44,
      "color": "#FFFFFF",
      "align": "center",
      "valign": "middle",
      "x": 80,
      "y": 530,
      "width": 920,
      "height": 90
    },
    {
      "id": "handle-text",
      "type": "text",
      "content": "@{{handle}}",
      "fontRole": "fixed",
      "font": "rubik-medium",
      "fontSize": 40,
      "color": "#FFD60A",
      "align": "center",
      "valign": "middle",
      "x": 80,
      "y": 620,
      "width": 920,
      "height": 60
    },
    {
      "id": "bio-text",
      "type": "text",
      "content": "{{bio}}",
      "fontRole": "body",
      "font": "rubik",
      "fontSize": 38,
      "minFontSize": 26,
      "color": "#C9C9D4",
      "align": "center",
      "valign": "top",
      "x": 120,
      "y": 700,
      "width": 840,
      "height": 180
    },
    {
      "id": "stats-bg",
      "type": "rect",
      "x": 60,
      "y": 920,
      "width": 960,
      "height": 180,
      "fill": "#1C1C26",
      "radius": 20
    },
    {
      "id": "stat-1-text",
      "type": "text",
      "content": "{{stat-1}}",
      "fontRole": "fixed",
      "font": "rubik-medium",
      "fontSize": 36,
      "minFontSize": 24,
      "color": "#FFFFFF",
      "align": "center",
      "valign": "middle",
      "lineHeight": 1.25,
      "x": 80,
      "y": 940,
      "width": 300,
      "height": 140
    },
    {
      "id": "divider-1",
      "type": "rect",
      "x": 385,
      "y": 970,
      "width": 2,
      "height": 80,
      "fill": "#2E2E3A",
      "showIf": "stat-2"
    },
    {
      "id": "stat-2-text",
      "type": "text",
      "content": "{{stat-2}}",
      "fontRole": "fixed",
      "font": "rubik-medium",
      "fontSize": 36,
      "minFontSize": 24,
      "color": "#FFFFFF",
      "align": "center",
      "valign": "middle",
      "lineHeight": 1.25,
      "hideWhenEmpty": true,
      "x": 390,
      "y": 940,
      "width": 300,
      "height": 140
    },
    {
      "id": "divider-2",
      "type": "rect",
      "x": 695,
      "y": 970,
      "width": 2,
      "height": 80,
      "fill": "#2E2E3A",
      "showIf": "stat-3"
    },
    {
      "id": "stat-3-text",
      "type": "text",
      "content": "{{stat-3}}",
      "fontRole": "fixed",
      "font": "rubik-medium",
      "fontSize": 36,
      "minFontSize": 24,
      "color": "#FFFFFF",
      "align": "center",
      "valign": "middle",
      "lineHeight": 1.25,
      "hideWhenEmpty": true,
      "x": 700,
      "y": 940,
      "width": 300,
      "height": 140
    },
    {
      "id": "caption-text",
      "type": "text",
      "content": "{{caption}}",
      "fontRole": "body",
      "font": "rubik",
      "fontSize": 40,
      "minFontSize": 28,
      "color": "#FFFFFF",
      "align": "center",
      "valign": "middle",
      "hideWhenEmpty": true,
      "x": 100,
      "y": 1150,
      "width": 880,
      "height": 110
    },
    {
      "id": "brand",
      "type": "brand",
      "variant": "footer",
      "x": 0,
      "y": 1286,
      "width": 1080,
      "height": 64
    }
  ]
}
