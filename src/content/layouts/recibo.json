{
  "id": "recibo",
  "name": "Recibo",
  "version": 1,
  "canvas": {
    "width": 1080,
    "height": 1350,
    "heightWithoutBrand": 1286
  },
  "background": "#232326",
  "premium": true,
  "slots": [
    {
      "id": "store",
      "label": "Estabelecimento",
      "type": "name",
      "maxChars": 26,
      "maxLines": 1,
      "multiline": false,
      "placeholder": "ROLÊ DE SÁBADO LTDA"
    },
    {
      "id": "item-1",
      "label": "Item 1",
      "type": "stat",
      "maxChars": 42,
      "maxLines": 1,
      "multiline": false,
      "placeholder": "1x Arrependimento .......... 89,90"
    },
    {
      "id": "item-2",
      "label": "Item 2",
      "type": "stat",
      "maxChars": 42,
      "maxLines": 1,
      "multiline": false,
      "placeholder": "3x 'só mais uma' ........... 147,00",
      "optional": true
    },
    {
      "id": "item-3",
      "label": "Item 3",
      "type": "stat",
      "maxChars": 42,
      "maxLines": 1,
      "multiline": false,
      "placeholder": "1x Uber surge ............... 63,40",
      "optional": true
    },
    {
      "id": "total",
      "label": "Total",
      "type": "label",
      "maxChars": 16,
      "maxLines": 1,
      "multiline": false,
      "placeholder": "R$ 300,30"
    },
    {
      "id": "note",
      "label": "Observação",
      "type": "caption",
      "maxChars": 80,
      "maxLines": 2,
      "multiline": true,
      "placeholder": "Pagamento parcelado em 12x na dignidade",
      "optional": true
    }
  ],
  "elements": [
    {
      "id": "paper",
      "type": "rect",
      "x": 140,
      "y": 40,
      "width": 800,
      "height": 1206,
      "fill": "#FDFDF7",
      "radius": 6
    },
    {
      "id": "store-text",
      "type": "text",
      "content": "{{store}}",
      "fontRole": "display",
      "font": "oswald",
      "fontSize": 56,
      "minFontSize": 34,
      "color": "#111111",
      "align": "center",
      "valign": "middle",
      "uppercase": true,
      "x": 180,
      "y": 90,
      "width": 720,
      "height": 80
    },
    {
      "id": "sub",
      "type": "text",
      "content": "CUPOM NÃO FISCAL",
      "fontRole": "fixed",
      "font": "rubik",
      "fontSize": 28,
      "color": "#777777",
      "align": "center",
      "valign": "middle",
      "letterSpacing": 4,
      "x": 180,
      "y": 175,
      "width": 720,
      "height": 40
    },
    {
      "id": "rule-1",
      "type": "rect",
      "x": 180,
      "y": 230,
      "width": 720,
      "height": 2,
      "fill": "#D5D5CC"
    },
    {
      "id": "photo",
      "type": "image",
      "x": 290,
      "y": 260,
      "width": 500,
      "height": 400,
      "radius": 4,
      "defaultFit": "cover"
    },
    {
      "id": "rule-2",
      "type": "rect",
      "x": 180,
      "y": 690,
      "width": 720,
      "height": 2,
      "fill": "#D5D5CC"
    },
    {
      "id": "item-1-text",
      "type": "text",
      "content": "{{item-1}}",
      "fontRole": "fixed",
      "font": "rubik",
      "fontSize": 34,
      "minFontSize": 24,
      "color": "#111111",
      "align": "left",
      "valign": "middle",
      "x": 200,
      "y": 710,
      "width": 680,
      "height": 60
    },
    {
      "id": "item-2-text",
      "type": "text",
      "content": "{{item-2}}",
      "fontRole": "fixed",
      "font": "rubik",
      "fontSize": 34,
      "minFontSize": 24,
      "color": "#111111",
      "align": "left",
      "valign": "middle",
      "hideWhenEmpty": true,
      "x": 200,
      "y": 780,
      "width": 680,
      "height": 60
    },
    {
      "id": "item-3-text",
      "type": "text",
      "content": "{{item-3}}",
      "fontRole": "fixed",
      "font": "rubik",
      "fontSize": 34,
      "minFontSize": 24,
      "color": "#111111",
      "align": "left",
      "valign": "middle",
      "hideWhenEmpty": true,
      "x": 200,
      "y": 850,
      "width": 680,
      "height": 60
    },
    {
      "id": "rule-3",
      "type": "rect",
      "x": 180,
      "y": 930,
      "width": 720,
      "height": 2,
      "fill": "#D5D5CC"
    },
    {
      "id": "total-label",
      "type": "text",
      "content": "TOTAL",
      "fontRole": "fixed",
      "font": "bebas",
      "fontSize": 60,
      "color": "#111111",
      "align": "left",
      "valign": "middle",
      "letterSpacing": 4,
      "x": 200,
      "y": 950,
      "width": 300,
      "height": 80
    },
    {
      "id": "total-text",
      "type": "text",
      "content": "{{total}}",
      "fontRole": "fixed",
      "font": "bebas",
      "fontSize": 60,
      "minFontSize": 40,
      "color": "#C1121F",
      "align": "right",
      "valign": "middle",
      "x": 580,
      "y": 950,
      "width": 300,
      "height": 80
    },
    {
      "id": "note-text",
      "type": "text",
      "content": "{{note}}",
      "fontRole": "body",
      "font": "rubik-medium",
      "fontSize": 34,
      "minFontSize": 24,
      "color": "#444444",
      "align": "center",
      "valign": "middle",
      "hideWhenEmpty": true,
      "x": 200,
      "y": 1050,
      "width": 680,
      "height": 110
    },
    {
      "id": "thanks",
      "type": "text",
      "content": "OBRIGADO E VOLTE SEMPRE",
      "fontRole": "fixed",
      "font": "rubik",
      "fontSize": 26,
      "color": "#999999",
      "align": "center",
      "valign": "middle",
      "letterSpacing": 3,
      "x": 200,
      "y": 1180,
      "width": 680,
      "height": 40
    },
    {
      "id": "brand",
      "type": "brand",
      "variant": "footer",
      "x": 0,
      "y": 1286,
      "width": 1080,
      "height": 64
    }
  ]
}
