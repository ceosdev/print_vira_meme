{
  "id": "carteirinha",
  "name": "Carteirinha",
  "version": 1,
  "canvas": {
    "width": 1080,
    "height": 1080
  },
  "background": "#12263A",
  "premium": true,
  "slots": [
    {
      "id": "org",
      "label": "Órgão emissor",
      "type": "label",
      "maxChars": 26,
      "maxLines": 1,
      "multiline": false,
      "placeholder": "CONSELHO DO GRUPO"
    },
    {
      "id": "name",
      "label": "Nome",
      "type": "name",
      "maxChars": 22,
      "maxLines": 1,
      "multiline": false,
      "placeholder": "EU MESMO"
    },
    {
      "id": "role",
      "label": "Cargo",
      "type": "description",
      "maxChars": 60,
      "maxLines": 2,
      "multiline": true,
      "placeholder": "Especialista em chegar 10 min atrasado"
    },
    {
      "id": "code",
      "label": "Registro",
      "type": "label",
      "maxChars": 18,
      "maxLines": 1,
      "multiline": false,
      "placeholder": "Nº 0001/2026"
    },
    {
      "id": "valid",
      "label": "Validade",
      "type": "label",
      "maxChars": 34,
      "maxLines": 1,
      "multiline": false,
      "placeholder": "Válida enquanto durar a paciência",
      "optional": true
    },
    {
      "id": "caption",
      "label": "Legenda",
      "type": "caption",
      "maxChars": 60,
      "maxLines": 2,
      "multiline": true,
      "placeholder": "Apresentar sempre que cobrarem pontualidade",
      "optional": true
    }
  ],
  "elements": [
    {
      "id": "card-bg",
      "type": "rect",
      "x": 60,
      "y": 140,
      "width": 960,
      "height": 760,
      "fill": "#F5F5F0",
      "radius": 24
    },
    {
      "id": "header",
      "type": "rect",
      "x": 60,
      "y": 140,
      "width": 960,
      "height": 130,
      "fill": "#C1121F",
      "radius": 24
    },
    {
      "id": "header-patch",
      "type": "rect",
      "x": 60,
      "y": 210,
      "width": 960,
      "height": 60,
      "fill": "#C1121F"
    },
    {
      "id": "org-text",
      "type": "text",
      "content": "{{org}}",
      "fontRole": "fixed",
      "font": "bebas",
      "fontSize": 56,
      "minFontSize": 38,
      "color": "#FFFFFF",
      "align": "center",
      "valign": "middle",
      "letterSpacing": 6,
      "x": 90,
      "y": 140,
      "width": 900,
      "height": 130
    },
    {
      "id": "photo",
      "type": "image",
      "x": 110,
      "y": 310,
      "width": 300,
      "height": 380,
      "radius": 8,
      "defaultFit": "cover"
    },
    {
      "id": "photo-frame",
      "type": "rect",
      "x": 104,
      "y": 304,
      "width": 312,
      "height": 392,
      "fill": "transparent",
      "radius": 10,
      "border": {
        "color": "#12263A",
        "width": 4
      }
    },
    {
      "id": "name-label",
      "type": "text",
      "content": "NOME",
      "fontRole": "fixed",
      "font": "rubik",
      "fontSize": 26,
      "color": "#8A8A80",
      "align": "left",
      "valign": "middle",
      "letterSpacing": 3,
      "x": 450,
      "y": 310,
      "width": 520,
      "height": 36
    },
    {
      "id": "name-text",
      "type": "text",
      "content": "{{name}}",
      "fontRole": "display",
      "font": "oswald",
      "fontSize": 56,
      "minFontSize": 34,
      "color": "#111111",
      "align": "left",
      "valign": "middle",
      "uppercase": true,
      "x": 450,
      "y": 346,
      "width": 520,
      "height": 70
    },
    {
      "id": "role-label",
      "type": "text",
      "content": "CARGO",
      "fontRole": "fixed",
      "font": "rubik",
      "fontSize": 26,
      "color": "#8A8A80",
      "align": "left",
      "valign": "middle",
      "letterSpacing": 3,
      "x": 450,
      "y": 430,
      "width": 520,
      "height": 36
    },
    {
      "id": "role-text",
      "type": "text",
      "content": "{{role}}",
      "fontRole": "body",
      "font": "rubik-medium",
      "fontSize": 38,
      "minFontSize": 26,
      "color": "#111111",
      "align": "left",
      "valign": "top",
      "x": 450,
      "y": 466,
      "width": 520,
      "height": 90
    },
    {
      "id": "code-label",
      "type": "text",
      "content": "REGISTRO",
      "fontRole": "fixed",
      "font": "rubik",
      "fontSize": 26,
      "color": "#8A8A80",
      "align": "left",
      "valign": "middle",
      "letterSpacing": 3,
      "x": 450,
      "y": 570,
      "width": 520,
      "height": 36
    },
    {
      "id": "code-text",
      "type": "text",
      "content": "{{code}}",
      "fontRole": "fixed",
      "font": "rubik-bold",
      "fontSize": 40,
      "minFontSize": 28,
      "color": "#111111",
      "align": "left",
      "valign": "middle",
      "x": 450,
      "y": 606,
      "width": 520,
      "height": 56
    },
    {
      "id": "valid-rule",
      "type": "rect",
      "x": 110,
      "y": 730,
      "width": 860,
      "height": 2,
      "fill": "#D8D8CE",
      "showIf": "valid"
    },
    {
      "id": "valid-text",
      "type": "text",
      "content": "{{valid}}",
      "fontRole": "fixed",
      "font": "rubik",
      "fontSize": 30,
      "minFontSize": 22,
      "color": "#555555",
      "align": "left",
      "valign": "middle",
      "hideWhenEmpty": true,
      "x": 110,
      "y": 750,
      "width": 860,
      "height": 60
    },
    {
      "id": "caption-text",
      "type": "text",
      "content": "{{caption}}",
      "fontRole": "body",
      "font": "rubik-medium",
      "fontSize": 38,
      "minFontSize": 26,
      "color": "#FFFFFF",
      "align": "center",
      "valign": "middle",
      "hideWhenEmpty": true,
      "x": 60,
      "y": 920,
      "width": 960,
      "height": 64
    },
    {
      "id": "brand",
      "type": "brand",
      "variant": "pill",
      "x": 560,
      "y": 1000,
      "width": 480,
      "height": 56
    }
  ]
}
